{
  // Offline overlay: opencode-go entries mirror pi.dev (verified 2026-09-10); Codex context
  // follows the account's /codex/models (verified 2026-09-22). Sol/Luna API metadata and
  // API-equivalent rates follow https://developers.openai.com/api/docs/models/gpt-6-sol and
  // https://developers.openai.com/api/docs/models/gpt-6-luna. pi-ai 0.84.4 predates these models.
  "providers": {
    "openai": {
      "models": [
        {
          "id": "gpt-6-sol",
          "name": "GPT-6 Sol",
          "api": "openai-responses",
          "baseUrl": "https://api.openai.com/v1",
          "reasoning": true,
          "input": ["text", "image"],
          "cost": { "input": 2, "output": 10, "cacheRead": 0.2, "cacheWrite": 2.5 },
          "contextWindow": 1050000,
          "maxTokens": 128000,
          "thinkingLevelMap": { "low": "low", "medium": "medium", "high": "high", "xhigh": "xhigh", "max": "max" }
        },
        {
          "id": "gpt-6-luna",
          "name": "GPT-6 Luna",
          "api": "openai-responses",
          "baseUrl": "https://api.openai.com/v1",
          "reasoning": true,
          "input": ["text", "image"],
          "cost": { "input": 0.1, "output": 0.5, "cacheRead": 0.01, "cacheWrite": 0.125 },
          "contextWindow": 1050000,
          "maxTokens": 128000,
          "thinkingLevelMap": { "low": "low", "medium": "medium", "high": "high", "xhigh": "xhigh", "max": "max" }
        }
      ]
    },
    "openai-codex": {
      "models": [
        {
          "id": "gpt-6-sol",
          "name": "GPT-6 Sol",
          "api": "openai-codex-responses",
          "baseUrl": "https://chatgpt.com/backend-api",
          "reasoning": true,
          "input": ["text", "image"],
          // Codex default context is 272000; its max_context_window 872000 is not the ordinary
          // limit. Public API context (1050000) is a separate route, not this subscription path.
          "cost": { "input": 2, "output": 10, "cacheRead": 0.2, "cacheWrite": 2.5 },
          "contextWindow": 272000,
          "maxTokens": 128000,
          "thinkingLevelMap": { "low": "low", "medium": "medium", "high": "high", "xhigh": "xhigh", "max": "max" }
        },
        {
          "id": "gpt-6-luna",
          "name": "GPT-6 Luna",
          "api": "openai-codex-responses",
          "baseUrl": "https://chatgpt.com/backend-api",
          "reasoning": true,
          "input": ["text", "image"],
          "cost": { "input": 0.1, "output": 0.5, "cacheRead": 0.01, "cacheWrite": 0.125 },
          "contextWindow": 272000,
          "maxTokens": 128000,
          "thinkingLevelMap": { "low": "low", "medium": "medium", "high": "high", "xhigh": "xhigh", "max": "max" }
        }
      ]
    },
    "opencode-go": {
      "models": [
        {
          "id": "muse-spark-1.3-contributor",
          "name": "Muse Spark 1.3 Contributor",
          "api": "openai-responses",
          "baseUrl": "https://opencode.ai/zen/go/v1",
          "reasoning": true,
          "input": ["text", "image"],
          "cost": { "input": 0.1, "output": 0.2, "cacheRead": 0.002, "cacheWrite": 0 },
          "contextWindow": 1048576,
          "maxTokens": 131072,
          "compat": { "sessionAffinityFormat": "openai-nosession" },
          "thinkingLevelMap": { "off": null, "minimal": "minimal", "low": "low", "medium": "medium", "high": "high", "xhigh": "xhigh", "max": null }
        },
        {
          "id": "deepseek-flash",
          "name": "DeepSeek V4.1 Flash",
          "api": "openai-completions",
          "baseUrl": "https://opencode.ai/zen/go/v1",
          "reasoning": true,
          "input": ["text", "image"],
          "cost": { "input": 0.15, "output": 0.6, "cacheRead": 0.003, "cacheWrite": 0 },
          // Published entry declares supportsStore/supportsDeveloperRole/maxTokensField only. Every other
          // DeepSeek model on this same baseUrl also declares thinkingFormat "deepseek" and
          // requiresReasoningContentOnAssistantMessages, and the transport only applies them for provider
          // "deepseek" or a deepseek.com baseUrl -- never for opencode.ai. Without them the request would
          // send neither the thinking toggle nor reasoning_content on prior assistant turns, which
          // https://api-docs.deepseek.com/guides/thinking_mode requires for tool requests (400) and keeps
          // reasoning in context. Declared here so no name/baseUrl heuristic has to fire.
          "compat": {
            "supportsStore": false,
            "supportsDeveloperRole": false,
            "maxTokensField": "max_tokens",
            "requiresReasoningContentOnAssistantMessages": true,
            "thinkingFormat": "deepseek"
          },
          "contextWindow": 1000000,
          "maxTokens": 384000,
          // max stays max: it is the route's top reasoning level and is never downgraded. xhigh is
          // unsupported here, so it stays null and createRuntime rejects it instead of remapping to high.
          "thinkingLevelMap": { "off": null, "minimal": null, "low": "low", "medium": null, "high": "high", "xhigh": null, "max": "max" }
        }
      ]
    }
  }
}
