# The OMP agent's own state. models.yml holds a provider API key in plaintext and agent.db is the
# credential store; neither belongs in a checkout even as a copied-in reference.
.omp/
models.yml
agent.db
*.sqlite
*.sqlite3
*.db

# Run artifacts. .civ6/ already covers the normal location; this catches a transcript or snapshot
# dropped anywhere else in the tree.
*.jsonl

# Python and test-generated state.
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage/

# Local logs and operating-system junk.
*.log
logs/
.DS_Store
._*
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

